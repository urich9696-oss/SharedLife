# SharedLife environment template
# Copy to .env.local for development. Never commit real secrets.

# Public Supabase client (safe for frontend)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public VAPID key for Web Push subscription in the browser
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# App identity
VITE_APP_NAME=SharedLife
VITE_DEFAULT_TIMEZONE=Europe/Zurich

# --- Server / Edge Function secrets (NOT for Vite frontend) ---
# SUPABASE_SERVICE_ROLE_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=...
# SYNC_HMAC_SECRET=optional-extra
